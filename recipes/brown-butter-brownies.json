{
  "title": "Brown Butter Brownies",
  "slug": "brown-butter-brownies",
  "description": "Rich and fudgy brownies!",
  "info": {
    "time": "Time: 50 minutes",
    "servings": "Servings: 9 brownies"
  },
  "ingredients": [
    {
      "section": "Main",
      "items": [
        {
          "number": 1,
          "text": "3/4 cup unsalted butter",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 2,
          "text": "3/4 cup cocoa powder",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 3,
          "text": "1 tsp vanilla extract",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 4,
          "text": "1-3/4 cup packed light brown sugar",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 5,
          "text": "3 large eggs",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 6,
          "text": "3/4 cup all-purpose flour",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 7,
          "text": "1/2 tsp salt",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 8,
          "text": "1/2 cup semisweet or bittersweet chocolate chips",
          "ingredient": null,
          "aliases": []
        }
      ]
    }
  ],
  "steps": [
    {
      "text": "Preheat oven to 350\u00b0F. Grease and line a 9 x 9 inch pan with parchment paper.",
      "ingredients": []
    },
    {
      "text": "Melt butter in a small pan over medium-low heat. Constantly scrape bottom of the pan until butter starts to turn brown and small brown bits begin floating, about 10-15 minutes. Once the butter is golden brown, remove from heat.",
      "ingredients": [
        1
      ]
    },
    {
      "text": "To the brown butter, add cocoa powder and vanilla, whisk until well combined.",
      "ingredients": [
        2,
        3
      ]
    },
    {
      "text": "In a stand mixer with whisk attachment, add eggs and brown sugar. Beat until light, fluffy, and pale in color.",
      "ingredients": [
        4,
        5
      ]
    },
    {
      "text": "Fold butter mixture into egg mixture.",
      "ingredients": []
    },
    {
      "text": "Fold in flour and salt until combined.",
      "ingredients": [
        6,
        7
      ]
    },
    {
      "text": "Fold in chocolate chips.",
      "ingredients": [
        8
      ]
    },
    {
      "text": "Pour mixture into baking pan. Bake until edges set but a toothpick in the center still leaves a little batter left, about 25 minutes.",
      "ingredients": []
    }
  ],
  "notes": [
    ""
  ],
