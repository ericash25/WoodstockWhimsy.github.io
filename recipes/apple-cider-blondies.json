  "ingredients": [
    {
      "section": "Blondies",
      "items": [
        {
          "number": 1,
          "text": "2 cups apple cider",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 2,
          "text": "1/2 cup melted butter (113g)",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 3,
          "text": "1 cup brown sugar (200g)",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 4,
          "text": "1 egg + 1 egg yolk",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 5,
          "text": "1 tsp vanilla extract",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 6,
          "text": "1 cup all-purpose flour (126g)",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 7,
          "text": "1/4 tsp baking powder",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 8,
          "text": "1/4 tsp kosher salt",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 9,
          "text": "1/2 tsp cinnamon",
          "ingredient": null,
          "aliases": []
        }
      ]
    },
    {
      "section": "Topping",
      "items": [
        {
          "number": 10,
          "text": "1/3 cup white granulated sugar (66g)",
          "ingredient": null,
          "aliases": []
        },
        {
          "number": 11,
          "text": "1 tsp cinnamon",
          "ingredient": null,
          "aliases": []
        }
      ]
    }
  ],
  "steps": [
    {
      "text": "Place a 2 quart saucepan over medium-high heat and add in apple cider. Bring to a simmer, stirring occasionally. After about 30 minutes, the apple cider should be reduced to about half. Increase heat to come to a rolling boil and continue to stir, about 5 minutes. Turn heat down to low and check on reduction, there should only be about a 1/4 cup of syrup. Set aside.",
      "ingredients": [
        1
      ]
    },
    {
      "text": "Preheat oven to 350\u00b0F. Line an 8 x 8 baking pan with parchment paper.",
      "ingredients": []
    },
    {
      "text": "In a large bowl, combine melted butter and brown sugar.",
      "ingredients": [
        2,
        3
      ]
    },
    {
      "text": "Mix in eggs and vanilla extract.",
      "ingredients": [
        4,
        5
      ]
    },
    {
      "text": "Mix in apple cider reduction until smooth.",
      "ingredients": []
    },
    {
      "text": "Add in flour, salt, baking powder, and cinnamon. Mix until combined and pour mixture into prepared pan.",
      "ingredients": [
        6,
        7,
        8,
        9
      ]
    },
    {
      "text": "In a small bowl, combine sugar and cinnamon and mix thoroughly.",
      "ingredients": [
        10,
        11
      ]
    },
    {
      "text": "Sprinkle cinnamon sugar mixture over the batter in the pan.",
      "ingredients": []
    },
    {
      "text": "Bake for 28 to 30 minutes, or until the edges are fully set. Use a toothpick to check if done.",
      "ingredients": []
    },
    {
      "text": "Remove pan from oven and allow to cool for 20 minutes.",
      "ingredients": []
    }
  ],
  "notes": [
    "For a more fudgy blondie instead of cakey, bake for less time."
  ],
