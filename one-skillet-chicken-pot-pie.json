  "steps": [
    {
      "text": "Preheat oven to 375 F.",
      "ingredients": []
    },
    {
      "text": "In a skillet, heat olive oil over medium high heat. Add carrots, celery, and shallots. Saute until tender, then remove from pan and set aside.",
      "ingredients": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "text": "In the same skillet, add butter and melt until foamy. Add in flour, whisking as you add to form your roux. Once combined, whisk in your dry white wine and heat for about 30 seconds and allow to simmer. Slowly add in chicken stock, whisking as you pour. Finally, add heavy cream and simmer mixture for about 10 minutes.",
      "ingredients": [
        5,
        6,
        7,
        8,
        9
      ]
    },
    {
      "text": "Add the cooked carrots, celery, and shallots back into the skillet. Add chicken, corn, peas, and parsley, stir to combine.",
      "ingredients": [
        10,
        11,
        12,
        13
      ]
    },
    {
      "text": "Cut your puff pastry into strips and layer on top to form a crust. Brush beaten egg onto the puff pastry.",
      "ingredients": [
        14,
        15
      ]
    },
    {
      "text": "Bake for 30-40 minutes, until a golden brown top is formed.",
      "ingredients": []
    }
  ],
  "notes": [
    "Allow to rest for 10 mins before serving."
